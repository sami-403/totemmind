<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" 
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence 
             https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd" 
             version="3.1">

    <persistence-unit name="meuPU" transaction-type="RESOURCE_LOCAL">
        
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <!-- Classes da sua aplicação -->
        <class>com.br.devsami.model.entity.Person</class>
        <class>com.br.devsami.model.entity.User</class>
        <class>com.br.devsami.model.entity.Employee</class>

        <properties>
            <!--  Configurações do Banco H2  -->
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:./dados/bd"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!--  Dialeto H2  -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>

            <!--  Configurações Hibernate  -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>