<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane prefHeight="600.0" prefWidth="800.0"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.devsami.controller.AdminLoginController">

    <VBox alignment="TOP_CENTER" maxWidth="400.0" spacing="20.0">
        <padding>
            <Insets top="60.0" />
        </padding>

        <!-- Botão Voltar -->
        <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
            <Button onAction="#voltarParaMenu" style="-fx-background-radius: 50em; -fx-min-width: 40px; -fx-min-height: 40px; -fx-background-color: transparent; -fx-border-color: #555; -fx-border-radius: 50em; -fx-cursor: hand;" BorderPane.alignment="CENTER">
                <graphic>
                    <FontIcon iconLiteral="mdi-arrow-left" iconColor="white" iconSize="20"/>
                </graphic>
            </Button>
        </HBox>

        <ImageView fitHeight="160.0" fitWidth="420.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@../images/totemMind_logo.png"/>
        </ImageView>

        <Label text="Autenticação Restrita" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;">
            <VBox.margin>
                <Insets top="20.0" bottom="10.0"/>
            </VBox.margin>
        </Label>

        <!-- Formulário de Login -->
        <VBox spacing="15.0" maxWidth="Infinity">

            <TextField fx:id="cpfField" promptText="CPF do Gerente" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa; -fx-padding: 12px; -fx-font-size: 14px; -fx-background-radius: 5px;"/>

            <PasswordField fx:id="senhaField" promptText="Senha" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa; -fx-padding: 12px; -fx-font-size: 14px; -fx-background-radius: 5px;"/>

            <Button onAction="#handleLogin" text="Acessar Gerenciamento" maxWidth="Infinity" style="-fx-background-color: #1A9347; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 12px; -fx-font-size: 14px; -fx-font-weight: bold;">
                <VBox.margin>
                    <Insets top="10.0"/>
                </VBox.margin>
            </Button>

        </VBox>
    </VBox>
</StackPane>