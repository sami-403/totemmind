<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.br.devsami.controller.ListaProdutosController"
           prefHeight="400.0" prefWidth="600.0">

    <VBox alignment="TOP_CENTER" maxWidth="400.0" spacing="30.0">
        <padding>
            <Insets top="60.0" />
        </padding>

        <BorderPane>
            <left>
                <Button onAction="#voltar" style="-fx-background-radius: 50em; -fx-min-width: 40px; -fx-min-height: 40px; -fx-background-color: transparent; -fx-border-color: #555; -fx-border-radius: 50em; -fx-cursor: hand;" BorderPane.alignment="CENTER">
                    <graphic>
                        <FontIcon iconLiteral="mdi-arrow-left" iconColor="white" iconSize="20"/>
                    </graphic>
                </Button>
            </left>
            <center>
                <ImageView fitHeight="120.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" BorderPane.alignment="CENTER">
                    <Image url="/images/totemMind_logo.png"/>
                </ImageView>
            </center>
            <right>
                <Region prefWidth="40.0" BorderPane.alignment="CENTER"/>
            </right>
        </BorderPane>

        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <!-- Botão para adicionar itens, mapeado para o método no Controller -->
            <Button fx:id="btnAdicionar" mnemonicParsing="false" onAction="#handleAdicionar" text="Adicionar Novo Item"/>

            <!-- O VBox.vgrow="ALWAYS" faz a paginação ocupar todo o espaço restante -->
            <Pagination fx:id="paginacao" maxPageIndicatorCount="5" VBox.vgrow="ALWAYS"/>
        </VBox>
    </VBox>
</StackPane>
