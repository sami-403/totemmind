<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="600.0" prefWidth="800.0"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.devsami.controller.AvaliacaoProdutoController">

    <VBox alignment="TOP_CENTER" maxWidth="400.0" spacing="25.0">
        <padding>
            <Insets top="40.0" />
        </padding>

        <BorderPane>
            <left>
                <Button onAction="#voltar" style="-fx-background-radius: 50em; -fx-min-width: 40px; -fx-min-height: 40px; -fx-background-color: transparent; -fx-border-color: #555; -fx-border-radius: 50em; -fx-cursor: hand;">
                    <graphic>
                        <FontIcon iconLiteral="mdi-arrow-left" iconColor="#f39c12" iconSize="20"/>
                    </graphic>
                </Button>
            </left>
            <center>
                <ImageView fitHeight="120.0" fitWidth="260.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@../images/totemMind_logo.png"/>
                </ImageView>
            </center>
            <right>
                <Region prefWidth="40.0"/>
            </right>
        </BorderPane>

        <VBox spacing="10.0">
            <Label text="PRODUTO" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <ComboBox fx:id="cbProdutos" maxWidth="Infinity" promptText="Selecione o Produto" style="-fx-background-color: #3a3a3c; -fx-padding: 8px;"/>
        </VBox>

        <VBox alignment="CENTER" spacing="10.0">
            <Label text="AVALIAÇÃO DO PRODUTO (1 A 5 ESTRELAS)" style="-fx-text-fill: #aaa; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            <HBox alignment="CENTER" spacing="10.0">
                <Button fx:id="btnEstrela1" text=" 1" onAction="#selecionarEstrela1" style="-fx-background-color: #3a3a3c; -fx-text-fill: #aaa; -fx-cursor: hand; -fx-padding: 10px 14px; -fx-background-radius: 8px; -fx-font-size: 15px; -fx-font-weight: bold;">
                    <graphic>
                        <FontIcon fx:id="iconEstrela1" iconLiteral="mdi-star" iconColor="#666666" iconSize="22"/>
                    </graphic>
                </Button>
                <Button fx:id="btnEstrela2" text=" 2" onAction="#selecionarEstrela2" style="-fx-background-color: #3a3a3c; -fx-text-fill: #aaa; -fx-cursor: hand; -fx-padding: 10px 14px; -fx-background-radius: 8px; -fx-font-size: 15px; -fx-font-weight: bold;">
                    <graphic>
                        <FontIcon fx:id="iconEstrela2" iconLiteral="mdi-star" iconColor="#666666" iconSize="22"/>
                    </graphic>
                </Button>
                <Button fx:id="btnEstrela3" text=" 3" onAction="#selecionarEstrela3" style="-fx-background-color: #3a3a3c; -fx-text-fill: #aaa; -fx-cursor: hand; -fx-padding: 10px 14px; -fx-background-radius: 8px; -fx-font-size: 15px; -fx-font-weight: bold;">
                    <graphic>
                        <FontIcon fx:id="iconEstrela3" iconLiteral="mdi-star" iconColor="#666666" iconSize="22"/>
                    </graphic>
                </Button>
                <Button fx:id="btnEstrela4" text=" 4" onAction="#selecionarEstrela4" style="-fx-background-color: #3a3a3c; -fx-text-fill: #aaa; -fx-cursor: hand; -fx-padding: 10px 14px; -fx-background-radius: 8px; -fx-font-size: 15px; -fx-font-weight: bold;">
                    <graphic>
                        <FontIcon fx:id="iconEstrela4" iconLiteral="mdi-star" iconColor="#666666" iconSize="22"/>
                    </graphic>
                </Button>
                <Button fx:id="btnEstrela5" text=" 5" onAction="#selecionarEstrela5" style="-fx-background-color: #3a3a3c; -fx-text-fill: #aaa; -fx-cursor: hand; -fx-padding: 10px 14px; -fx-background-radius: 8px; -fx-font-size: 15px; -fx-font-weight: bold;">
                    <graphic>
                        <FontIcon fx:id="iconEstrela5" iconLiteral="mdi-star" iconColor="#666666" iconSize="22"/>
                    </graphic>
                </Button>
            </HBox>
            <Label fx:id="lblNotaDescricao" text="Selecione de 1 a 5 estrelas" style="-fx-text-fill: #f39c12; -fx-font-size: 14px; -fx-font-weight: bold;"/>
        </VBox>

        <TextArea fx:id="txtFeedback" promptText="FEEDBACK OPCIONAL" prefHeight="100.0" wrapText="true" style="-fx-control-inner-background: #3a3a3c; -fx-text-fill: white;"/>

        <HBox alignment="CENTER_RIGHT">
            <Button text="Enviar!" onAction="#enviar" style="-fx-background-color: #1e9759; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 10px 30px;"/>
        </HBox>
    </VBox>
</StackPane>
