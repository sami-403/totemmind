<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="600.0" prefWidth="1000.0" stylesheets="@/css/chat.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.devsami.controller.ChatAssistenteController">

    <SplitPane dividerPositions="0.6" style="-fx-background-color: transparent; -fx-padding: 15px;">

        <VBox alignment="TOP_CENTER" spacing="15.0">
            <padding>
                <Insets top="10.0" bottom="10.0" left="10.0" right="10.0"/>
            </padding>

            <BorderPane>
                <left>
                    <Button onAction="#voltar" style="-fx-background-radius: 50em; -fx-min-width: 40px; -fx-min-height: 40px; -fx-background-color: transparent; -fx-border-color: #555; -fx-border-radius: 50em; -fx-cursor: hand;" BorderPane.alignment="CENTER">
                        <graphic>
                            <FontIcon iconLiteral="mdi-arrow-left" iconColor="white" iconSize="20"/>
                        </graphic>
                    </Button>
                </left>
                <center>
                    <VBox alignment="CENTER" spacing="5.0" BorderPane.alignment="CENTER">
                        <ImageView fitHeight="120.0" fitWidth="260.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../images/totemMind_logo.png"/>
                        </ImageView>
                        <Label text="CHAT DO ASSISTENTE" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #aaa;"/>
                    </VBox>
                </center>
                <right>
                    <Region prefWidth="40.0" BorderPane.alignment="CENTER"/>
                </right>
            </BorderPane>

            <ListView fx:id="chatListView" VBox.vgrow="ALWAYS" style="-fx-background-color: #1c1c1e; -fx-border-color: #333333; -fx-border-width: 1px; -fx-border-radius: 12px; -fx-background-radius: 12px;"/>

            <HBox spacing="10.0" alignment="CENTER" style="-fx-background-color: #2c2c2e; -fx-padding: 8px 12px; -fx-background-radius: 50em; -fx-border-color: #444444; -fx-border-radius: 50em;">
                <TextField fx:id="txtInput" promptText="Pergunte ao Kicer..." HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 15px;"/>
                <Button onAction="#enviarMensagem" style="-fx-background-color: #1e9759; -fx-background-radius: 50em; -fx-cursor: hand; -fx-min-width: 40px; -fx-min-height: 40px;">
                    <graphic>
                        <FontIcon iconLiteral="mdi-send" iconColor="white" iconSize="18"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>

        <VBox fx:id="painelGrafico" alignment="CENTER" spacing="15.0" style="-fx-background-color: #1c1c1e; -fx-border-color: #333333; -fx-border-width: 1px; -fx-border-radius: 12px; -fx-background-radius: 12px;">
            <padding>
                <Insets top="20.0" bottom="20.0" left="20.0" right="20.0"/>
            </padding>
            <FontIcon iconLiteral="mdi-chart-pie" iconColor="#444444" iconSize="64"/>
            <Label text="Os gráficos solicitados aparecerão aqui" style="-fx-text-fill: #555555; -fx-font-size: 14px; -fx-wrap-text: true; -fx-text-alignment: center;"/>
        </VBox>

    </SplitPane>
</StackPane>