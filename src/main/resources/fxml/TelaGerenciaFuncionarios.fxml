<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.devsami.controller.TelaGerenciaFuncionariosController">


    <VBox alignment="TOP_CENTER" maxWidth="400.0" spacing="20.0">


        <padding>
            <Insets top="60.0" />
        </padding>

        <BorderPane>
            <left>
                <Button onAction="#voltar" style="-fx-background-radius: 50em; -fx-min-width: 40px; -fx-min-height: 40px; -fx-background-color: transparent; -fx-border-color: #555; -fx-border-radius: 50em; -fx-cursor: hand;" BorderPane.alignment="CENTER">
                    <graphic>
                        <FontIcon iconLiteral="mdi-arrow-left" iconColor="white" iconSize="20"/>
                    </graphic>
                </Button>
            </left>
        </BorderPane>

        <ImageView fitHeight="160.0" fitWidth="420.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@../images/totemMind_logo.png"/>
        </ImageView>

        <HBox spacing="10.0" alignment="CENTER" maxWidth="Infinity">
            <Button onAction="#setModeAdd" text="Adicionar" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #333333; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 12px; -fx-font-size: 14px;">
                <graphic><FontIcon iconLiteral="mdi-account-plus" iconColor="white" iconSize="20"/></graphic>
            </Button>
            <Button onAction="#setModeEdit" text="Editar" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #333333; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 12px; -fx-font-size: 14px;">
                <graphic><FontIcon iconLiteral="mdi-pencil" iconColor="white" iconSize="20"/></graphic>
            </Button>
            <Button onAction="#setModeRemove" text="Remover" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #333333; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 12px; -fx-font-size: 14px;">
                <graphic><FontIcon iconLiteral="mdi-account-minus" iconColor="white" iconSize="20"/></graphic>
            </Button>
        </HBox>

        <VBox fx:id="formContainer" spacing="15.0" maxWidth="Infinity" visible="false" managed="false">
            <padding>
                <Insets top="10.0" />
            </padding>

            <Label fx:id="formTitle" text="Título" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 5px;"/>

            <TextField fx:id="idField" promptText="ID do Funcionário"
                       style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa; -fx-padding: 12px; -fx-font-size: 14px; -fx-background-radius: 5px;"/>

            <TextField fx:id="nameField" promptText="Nome"
                       style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa; -fx-padding: 12px; -fx-font-size: 14px; -fx-background-radius: 5px;"/>

            <TextField fx:id="cpfField" promptText="CPF"
                       style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa; -fx-padding: 12px; -fx-font-size: 14px; -fx-background-radius: 5px;"/>

            <ComboBox fx:id="typeComboBox" promptText="Tipo de Funcionário" maxWidth="Infinity"
                      style="-fx-background-color: #333333; -fx-text-fill: white; -fx-padding: 12px; -fx-font-size: 14px; -fx-background-radius: 5px;"/>

            <PasswordField fx:id="passwordField" promptText="SENHA (Gerente)"
                           style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa; -fx-padding: 12px; -fx-font-size: 14px; -fx-background-radius: 5px;"/>

            <Button fx:id="actionButton" onAction="#handleAction" text="Confirmar Ação" maxWidth="Infinity"
                    style="-fx-background-color: #1A9347; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 12px; -fx-font-size: 14px; -fx-font-weight: bold;">
            </Button>
        </VBox>
    </VBox>
</StackPane>