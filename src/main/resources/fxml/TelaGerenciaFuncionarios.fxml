<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.br.devsami.controller.TelaGerenciaFuncionariosController">


    <VBox alignment="TOP_CENTER" spacing="15.0">
        <padding>
            <Insets top="30.0" left="20.0" right="20.0" bottom="20.0"/>
        </padding>

        <BorderPane>
            <left>
                <Button onAction="#voltar" style="-fx-background-radius: 50em; -fx-min-width: 40px; -fx-min-height: 40px; -fx-background-color: transparent; -fx-border-color: #555; -fx-border-radius: 50em; -fx-cursor: hand;" BorderPane.alignment="CENTER">
                    <graphic>
                        <FontIcon iconLiteral="mdi-arrow-left" iconColor="white" iconSize="20"/>
                    </graphic>
                </Button>
            </left>
            <center>
                <ImageView fitHeight="100.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
                    <Image url="@../images/totemMind_logo.png"/>
                </ImageView>
            </center>
        </BorderPane>

        <HBox spacing="30.0" alignment="CENTER" VBox.vgrow="ALWAYS">
            <!-- Lado Esquerdo: Listagem de Funcionários -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS" minWidth="360.0">
                <Label text="Funcionários Cadastrados" style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
                <TableView fx:id="tvFuncionarios" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #333333; -fx-text-fill: white;">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50.0" />
                        <TableColumn fx:id="colNome" text="Nome" prefWidth="120.0" />
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100.0" />
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="80.0" />
                    </columns>
                </TableView>
            </VBox>

            <!-- Lado Direito: Formulário e Ações -->
            <VBox spacing="15.0" prefWidth="360.0" alignment="TOP_CENTER">
                <HBox spacing="10.0" alignment="CENTER" maxWidth="Infinity">
                    <Button onAction="#setModeAdd" text="Adicionar" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #333333; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10px; -fx-font-size: 13px;">
                        <graphic><FontIcon iconLiteral="mdi-account-plus" iconColor="white" iconSize="16"/></graphic>
                    </Button>
                    <Button onAction="#setModeEdit" text="Editar" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #333333; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10px; -fx-font-size: 13px;">
                        <graphic><FontIcon iconLiteral="mdi-pencil" iconColor="white" iconSize="16"/></graphic>
                    </Button>
                    <Button onAction="#setModeRemove" text="Remover" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #333333; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10px; -fx-font-size: 13px;">
                        <graphic><FontIcon iconLiteral="mdi-account-minus" iconColor="white" iconSize="16"/></graphic>
                    </Button>
                </HBox>

                <VBox fx:id="formContainer" spacing="10.0" maxWidth="Infinity" visible="false" managed="false">
                    <Label fx:id="formTitle" text="Título" style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                    <TextField fx:id="idField" promptText="ID do Funcionário"
                               style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa; -fx-padding: 10px; -fx-font-size: 13px; -fx-background-radius: 5px;"/>

                    <TextField fx:id="nameField" promptText="Nome"
                               style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa; -fx-padding: 10px; -fx-font-size: 13px; -fx-background-radius: 5px;"/>

                    <TextField fx:id="cpfField" promptText="CPF"
                               style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa; -fx-padding: 10px; -fx-font-size: 13px; -fx-background-radius: 5px;"/>

                    <ComboBox fx:id="typeComboBox" promptText="Tipo de Funcionário" maxWidth="Infinity"
                              style="-fx-background-color: #333333; -fx-text-fill: white; -fx-padding: 10px; -fx-font-size: 13px; -fx-background-radius: 5px;"/>

                    <PasswordField fx:id="passwordField" promptText="SENHA (Gerente)"
                                   style="-fx-background-color: #333333; -fx-text-fill: white; -fx-prompt-text-fill: #aaaaaa; -fx-padding: 10px; -fx-font-size: 13px; -fx-background-radius: 5px;"/>

                    <CheckBox fx:id="chkAtivo" text="Funcionário Ativo" selected="true"
                              style="-fx-text-fill: white; -fx-font-size: 13px;"/>

                    <Button fx:id="actionButton" onAction="#handleAction" text="Confirmar Ação" maxWidth="Infinity"
                            style="-fx-background-color: #1A9347; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10px; -fx-font-size: 13px; -fx-font-weight: bold;">
                    </Button>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</StackPane>